# docker compose가 읽는 값. 복사해서 .env로 사용한다. 로컬 bootRun은 backend/src/main/resources/application.yml 기본값을 쓴다.
DB_NAME=flexable
DB_USERNAME=flexable
DB_PASSWORD=flexable
DB_ROOT_PASSWORD=flexable-root
DB_PORT=3306

BACKEND_PORT=8080
# compose 밖의 DB를 쓸 때만 바꾼다.
# BACKEND_DB_URL=jdbc:mysql://host.docker.internal:3306/flexable?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost,capacitor://localhost

FRONTEND_PORT=3000

# Access Token 서명 키 (Base64, 32바이트 이상): openssl rand -base64 32
# 비우면 백엔드를 재시작할 때마다 모든 사용자가 다시 로그인해야 한다.
AUTH_JWT_SECRET=
# 프론트와 API가 다른 사이트(도메인)면 None으로 바꾸고 HTTPS를 쓴다.
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=true
